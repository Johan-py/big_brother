# Umbral: cada cuántas horas de uso se dispara el flujo completo
# (notificación IA -> terminal de Gilfoyle a los 10 s -> travesura a los 5 min)
INTERVALO_HORAS=1

# Directorio donde buscar música para la travesura "música aleatoria"
MUSICA_DIR=/home/USUARIO/Music

# Modelo de OpenRouter usado para generar los mensajes de Gilfoyle
MODELO=deepseek/deepseek-chat