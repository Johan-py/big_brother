#!/usr/bin/env sh
# xdds - Analiza 1..n archivos con DeepSeek vía OpenRouter.
#
# Instalación global (bash o zsh):
#   sudo ln -s "$(pwd)/xdds" /usr/local/bin/xdds
#   # o copiar: sudo cp xdds /usr/local/bin/xdds && sudo chmod +x /usr/local/bin/xdds
#
# Uso:
#   xdds archivo1.txt [archivo2.c ...]        analiza archivos 1..n
#   xdds --cat web reto.js                     categoría (web/crypto/reversing/...)
#   xdds --cat crypto ./reto_crypto/           analiza un directorio (recursivo)
#   xdds -o reporte.md reto/                   guarda el reporte en un archivo
#   xdds --scan-only ./reto/                   solo escaneo local de flags (gratis)
#   xdds --workers 8 archivos...               peticiones concurrentes
#
# Categorías: crypto web reversing forense osint stego misc

SCRIPT_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"

# Carga la clave desde .env junto a este script, si existe
if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$SCRIPT_DIR/.env"
    set +a
fi

# Si OPENROUTER_API_KEY sigue sin estar definida, pídela una vez y guárdala
if [ -z "$OPENROUTER_API_KEY" ]; then
    printf 'OPENROUTER_API_KEY no definida. Ingresa tu clave: '
    read -r OPENROUTER_API_KEY
    if [ -z "$OPENROUTER_API_KEY" ]; then
        echo "xdds: no se proporcionó clave. Aborta." >&2
        exit 1
    fi
    if [ -w "$SCRIPT_DIR" ] && [ -f "$SCRIPT_DIR/.env" ]; then
        echo "OPENROUTER_API_KEY=$OPENROUTER_API_KEY" >> "$SCRIPT_DIR/.env"
        echo "xdds: clave guardada en $SCRIPT_DIR/.env"
    fi
fi

export OPENROUTER_API_KEY

exec python3 "$SCRIPT_DIR/analiza.py" "$@"
